-- CRIAR BANCO

CREATE DATABASE sistema_votacao;

USE sistema_votacao;


-- TABELA ELEITOR

CREATE TABLE eleitor (

    id INT AUTO_INCREMENT PRIMARY KEY,

    nome_completo VARCHAR(150) NOT NULL,

    cpf VARCHAR(50) NOT NULL UNIQUE, -- CPF criptografado

    titulo_eleitor VARCHAR(20) NOT NULL UNIQUE,

    mesario BOOLEAN NOT NULL,

    chave_acesso VARCHAR(50) NOT NULL, -- Chave criptografada

    status_voto ENUM(
        'NAO_VOTOU',
        'JA_VOTOU'
    ) DEFAULT 'NAO_VOTOU'
);


-- TABELA CANDIDATO

CREATE TABLE candidato (

    id INT AUTO_INCREMENT PRIMARY KEY,

    nome VARCHAR(100) NOT NULL,

    numero INT NOT NULL UNIQUE,

    partido VARCHAR(50) NOT NULL
);


-- TABELA VOTO

CREATE TABLE voto (

    id INT AUTO_INCREMENT PRIMARY KEY,

    id_candidato INT,

    data_hora DATETIME NOT NULL,

    protocolo VARCHAR(50) NOT NULL, -- Protocolo criptografado

    FOREIGN KEY (id_candidato)
        REFERENCES candidato(id)
);


-- TABELA DE LOGS

CREATE TABLE log_ocorrencias (

    id INT AUTO_INCREMENT PRIMARY KEY,

    data_hora DATETIME NOT NULL,

    descricao TEXT NOT NULL
);


